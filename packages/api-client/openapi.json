{
  "openapi": "3.1.0",
  "info": {
    "title": "SmartBiz OS API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness: the API process is up. Does not touch the database.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/health/db": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Db",
        "description": "Readiness: the database answers.",
        "operationId": "health_db",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseHealthOut"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable (problem+json, code `database_unavailable`)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DatabaseHealthOut": {
        "properties": {
          "database": {
            "type": "string",
            "title": "Database"
          },
          "server_version": {
            "type": "string",
            "title": "Server Version"
          }
        },
        "type": "object",
        "required": [
          "database",
          "server_version"
        ],
        "title": "DatabaseHealthOut"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "product": {
            "type": "string",
            "title": "Product"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "product",
          "version"
        ],
        "title": "HealthOut"
      }
    }
  }
}
