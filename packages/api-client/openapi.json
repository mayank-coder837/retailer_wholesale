{
  "openapi": "3.1.0",
  "info": {
    "title": "SmartBiz OS API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness: the API process is up. Does not touch the database.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/health/db": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Db",
        "description": "Readiness: the database answers.",
        "operationId": "health_db",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseHealthOut"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable (problem+json, code `database_unavailable`)"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signup",
        "operationId": "signup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_credentials`"
          },
          "409": {
            "description": "`tenant_selection_required` — lists the user's accounts"
          },
          "423": {
            "description": "`account_locked`"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh",
        "operationId": "refresh",
        "parameters": [
          {
            "name": "smartbiz_refresh",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Smartbiz Refresh"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "401": {
            "description": "Session ended"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "operationId": "logout",
        "parameters": [
          {
            "name": "smartbiz_refresh",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Smartbiz Refresh"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshIn"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/switch-tenant": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Switch Tenant",
        "operationId": "switch_tenant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchTenantIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/businesses": {
      "get": {
        "tags": [
          "tenancy"
        ],
        "summary": "List Businesses",
        "operationId": "list_businesses",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BusinessOut"
                  },
                  "type": "array",
                  "title": "Response List Businesses"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "tenancy"
        ],
        "summary": "Create Business",
        "operationId": "create_business",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BusinessIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/businesses/{business_id}": {
      "get": {
        "tags": [
          "tenancy"
        ],
        "summary": "Get Business",
        "operationId": "get_business",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "business_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Business Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/businesses/{business_id}/branches": {
      "get": {
        "tags": [
          "tenancy"
        ],
        "summary": "List Branches",
        "operationId": "list_branches",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "business_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Business Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BranchOut"
                  },
                  "title": "Response List Branches"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "tenancy"
        ],
        "summary": "Create Branch",
        "operationId": "create_branch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "business_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Business Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BranchIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/branches/{branch_id}/warehouses": {
      "get": {
        "tags": [
          "tenancy"
        ],
        "summary": "List Warehouses",
        "operationId": "list_warehouses",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "branch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Branch Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WarehouseOut"
                  },
                  "title": "Response List Warehouses"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "tenancy"
        ],
        "summary": "Create Warehouse",
        "operationId": "create_warehouse",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "branch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Branch Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WarehouseIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WarehouseOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BranchIn": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Code"
          },
          "name_en": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name En"
          },
          "name_ar": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name Ar"
          },
          "address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "emirate": {
            "$ref": "#/components/schemas/Emirate",
            "description": "Decides the VAT 201 Box 1 line for sales this branch makes"
          },
          "is_head_office": {
            "type": "boolean",
            "title": "Is Head Office",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "code",
          "name_en",
          "name_ar",
          "emirate"
        ],
        "title": "BranchIn"
      },
      "BranchOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "business_id": {
            "type": "string",
            "format": "uuid",
            "title": "Business Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name_en": {
            "type": "string",
            "title": "Name En"
          },
          "name_ar": {
            "type": "string",
            "title": "Name Ar"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "emirate": {
            "$ref": "#/components/schemas/Emirate"
          },
          "is_head_office": {
            "type": "boolean",
            "title": "Is Head Office"
          }
        },
        "type": "object",
        "required": [
          "id",
          "business_id",
          "code",
          "name_en",
          "name_ar",
          "address",
          "emirate",
          "is_head_office"
        ],
        "title": "BranchOut"
      },
      "BusinessIn": {
        "properties": {
          "legal_name_en": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Legal Name En"
          },
          "legal_name_ar": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Legal Name Ar"
          },
          "trade_license_no": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Trade License No"
          },
          "trn": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{15}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trn",
            "description": "UAE TRN, 15 digits"
          },
          "vat_registered": {
            "type": "boolean",
            "title": "Vat Registered",
            "default": false
          },
          "base_currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Base Currency",
            "default": "AED"
          },
          "fiscal_year_start_month": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Fiscal Year Start Month",
            "default": 1
          },
          "time_zone": {
            "type": "string",
            "maxLength": 64,
            "title": "Time Zone",
            "default": "Asia/Dubai"
          }
        },
        "type": "object",
        "required": [
          "legal_name_en",
          "legal_name_ar"
        ],
        "title": "BusinessIn"
      },
      "BusinessOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "legal_name_en": {
            "type": "string",
            "title": "Legal Name En"
          },
          "legal_name_ar": {
            "type": "string",
            "title": "Legal Name Ar"
          },
          "trade_license_no": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trade License No"
          },
          "trn": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trn"
          },
          "vat_registered": {
            "type": "boolean",
            "title": "Vat Registered"
          },
          "base_currency": {
            "type": "string",
            "title": "Base Currency"
          },
          "fiscal_year_start_month": {
            "type": "integer",
            "title": "Fiscal Year Start Month"
          },
          "time_zone": {
            "type": "string",
            "title": "Time Zone"
          },
          "costing_method": {
            "type": "string",
            "title": "Costing Method"
          },
          "negative_stock_allowed": {
            "type": "boolean",
            "title": "Negative Stock Allowed"
          }
        },
        "type": "object",
        "required": [
          "id",
          "legal_name_en",
          "legal_name_ar",
          "trade_license_no",
          "trn",
          "vat_registered",
          "base_currency",
          "fiscal_year_start_month",
          "time_zone",
          "costing_method",
          "negative_stock_allowed"
        ],
        "title": "BusinessOut"
      },
      "ClientKind": {
        "type": "string",
        "enum": [
          "web",
          "desktop"
        ],
        "title": "ClientKind"
      },
      "DatabaseHealthOut": {
        "properties": {
          "database": {
            "type": "string",
            "title": "Database"
          },
          "server_version": {
            "type": "string",
            "title": "Server Version"
          }
        },
        "type": "object",
        "required": [
          "database",
          "server_version"
        ],
        "title": "DatabaseHealthOut"
      },
      "Emirate": {
        "type": "string",
        "enum": [
          "abu_dhabi",
          "dubai",
          "sharjah",
          "ajman",
          "umm_al_quwain",
          "ras_al_khaimah",
          "fujairah"
        ],
        "title": "Emirate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "product": {
            "type": "string",
            "title": "Product"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "product",
          "version"
        ],
        "title": "HealthOut"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id",
            "description": "Required when the user belongs to several"
          },
          "client": {
            "$ref": "#/components/schemas/ClientKind",
            "default": "web"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn"
      },
      "MeOut": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserOut"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantOut"
          },
          "membership_id": {
            "type": "string",
            "format": "uuid",
            "title": "Membership Id"
          },
          "node_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Node Id"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/MembershipOut"
            },
            "type": "array",
            "title": "Memberships"
          }
        },
        "type": "object",
        "required": [
          "user",
          "tenant",
          "membership_id",
          "node_id",
          "memberships"
        ],
        "title": "MeOut"
      },
      "MembershipOut": {
        "properties": {
          "membership_id": {
            "type": "string",
            "format": "uuid",
            "title": "Membership Id"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "title": "Tenant Id"
          },
          "tenant_name": {
            "type": "string",
            "title": "Tenant Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "membership_id",
          "tenant_id",
