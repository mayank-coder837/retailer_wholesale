    "sundry creditors": { "role": "supplier" },
    "stock-in-hand": { "role": "stock" },
    "bank accounts": { "type": "bank", "parent": "1100" },
    "cash-in-hand": { "type": "cash", "parent": "1100" },
    "current assets": { "type": "current_asset", "parent": "1100" },
    "deposits (asset)": { "type": "current_asset", "parent": "1100" },
    "loans & advances (asset)": { "type": "current_asset", "parent": "1100" },
    "misc. expenses (asset)": { "type": "current_asset", "parent": "1100" },
    "fixed assets": { "type": "fixed_asset", "parent": "1700" },
    "investments": { "type": "fixed_asset", "parent": "1700" },
    "current liabilities": { "type": "current_liability", "parent": "2100" },
    "bank od a/c": { "type": "current_liability", "parent": "2100" },
    "provisions": { "type": "current_liability", "parent": "2100" },
    "duties & taxes": { "type": "tax", "parent": "2100" },
    "loans (liability)": { "type": "non_current_liability", "parent": "2500" },
    "secured loans": { "type": "non_current_liability", "parent": "2500" },
    "unsecured loans": { "type": "non_current_liability", "parent": "2500" },
    "capital account": { "type": "equity", "parent": "3000" },
